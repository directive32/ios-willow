diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index ccbb188..777aca4 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -463,6 +463,25 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(SWEET)
+	/* Stage 0: white 64x32 band, no stack or page tables needed. */
+	MOV64	x0, (0x5c000000 + 2300 * 4320)
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #4320
+Lsweet_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+Lsweet_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsweet_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsweet_mark_row
+	dsb		sy
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -609,6 +628,165 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(SWEET)
+	/* Willow 4KB pages: framebuffer 0x5c000000 is in 1GB block 1 (0x40000000..0x7fffffff) */
+	MOV64	x10, 0x40000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	str		x11, [x25, #(1 * 8)]
+
+	/* Stage 0.5: Green 64x32 box at x=80..144 */
+	MOV64	x0, (0x5c000000 + 2300 * 4320 + 80 * 4)
+	mov		w1, #0xff00
+	mov		x2, #32
+	mov		x4, #4320
+Lwillow_green_row:
+	mov		x5, #64
+	mov		x6, x0
+Lwillow_green_pix:
+	str		w1, [x6], #4
+	subs	x5, x5, #1
+	b.ne	Lwillow_green_pix
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lwillow_green_row
+
+	dsb		ish
+	b		Lwillow_common_start
+
+Lwillow_common_start:
+	adrp	x0,     EXT(sysreg_restore)@page
+	add		x0, x0, EXT(sysreg_restore)@pageoff
+	ldr		x1, [x0, SR_RESTORE_TCR_EL1]
+	MSR_TCR_EL1_X1
+
+	and		x0, x25, #(TTBR_BADDR_MASK)
+	msr		TTBR0_EL1, x0
+	isb
+
+	add		x0, x25, PGBYTES
+	and		x0, x0, #(TTBR_BADDR_MASK)
+	MSR_TTBR1_EL1_X0
+
+	mov		x0, xzr
+	mov		x1, #(MAIR_WRITEBACK << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITEBACK))
+	orr		x0, x0, x1
+	mov		x1, #(MAIR_INNERWRITEBACK << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_INNERWRITEBACK))
+	orr		x0, x0, x1
+	mov		x1, #(MAIR_DISABLE << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_DISABLE))
+	orr		x0, x0, x1
+	mov		x1, #(MAIR_WRITETHRU << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITETHRU))
+	orr		x0, x0, x1
+	mov		x1, #(MAIR_WRITECOMB << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITECOMB))
+	orr		x0, x0, x1
+	mov		x1, #(MAIR_POSTED << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_POSTED))
+	orr		x0, x0, x1
+	mov		x1, #(MAIR_POSTED_REORDERED << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_POSTED_REORDERED))
+	orr		x0, x0, x1
+	mov		x1, #(MAIR_POSTED_COMBINED_REORDERED << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_POSTED_COMBINED_REORDERED))
+	orr		x0, x0, x1
+	msr		MAIR_EL1, x0
+	isb
+
+	tlbi	vmalle1
+	dsb		ish
+	tlbi	vmalle1
+	ic		iallu
+	dsb		sy
+	isb
+
+	adrp	x0, EXT(ExceptionVectorsBase)@page
+	add		x0, x0, EXT(ExceptionVectorsBase)@pageoff
+	add		x0, x0, x22
+	sub		x0, x0, x23
+	MSR_VBAR_EL1_X0
+
+	/* Stage 0.6: Yellow 64x32 box at x=160..224 right before enabling MMU */
+	MOV64	x0, (0x5c000000 + 2300 * 4320 + 160 * 4)
+	mov		w1, #0xffff
+	movk	w1, #0x00ff, lsl #16
+	mov		x2, #32
+	mov		x4, #4320
+Lwillow_yellow_row:
+	mov		x5, #64
+	mov		x6, x0
+Lwillow_yellow_pix:
+	str		w1, [x6], #4
+	subs	x5, x5, #1
+	b.ne	Lwillow_yellow_pix
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lwillow_yellow_row
+	dsb		sy
+
+	MOV64   x0, SCTLR_EL1_DEFAULT
+	MSR_SCTLR_EL1_X0
+	isb		sy
+
+	/* Stage 0.7: Cyan 64x32 box at x=240..304 immediately after MMU enabled */
+	MOV64	x0, (0x5c000000 + 2300 * 4320 + 240 * 4)
+	mov		w1, #0xffff
+	movk	w1, #0x0000, lsl #16
+	mov		x2, #32
+	mov		x4, #4320
+Lwillow_cyan_row:
+	mov		x5, #64
+	mov		x6, x0
+Lwillow_cyan_pix:
+	str		w1, [x6], #4
+	subs	x5, x5, #1
+	b.ne	Lwillow_cyan_pix
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lwillow_cyan_row
+	dsb		sy
+
+	mov		x0, #(CPACR_FPEN_ENABLE)
+	msr		CPACR_EL1, x0
+	msr		TPIDR_EL1, xzr
+	mrs		x12, MIDR_EL1
+
+	/* Stage 0.8: Magenta 64x32 box at x=320..384 right before calling arm_init */
+	MOV64	x0, (0x5c000000 + 2300 * 4320 + 320 * 4)
+	mov		w1, #0x00ff
+	movk	w1, #0x00ff, lsl #16
+	mov		x2, #32
+	mov		x4, #4320
+Lwillow_magenta_row:
+	mov		x5, #64
+	mov		x6, x0
+Lwillow_magenta_pix:
+	str		w1, [x6], #4
+	subs	x5, x5, #1
+	b.ne	Lwillow_magenta_pix
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lwillow_magenta_row
+	dsb		sy
+
+	/* Stage 0.9: Blue 64x32 box at x=400..464 */
+	MOV64	x0, (0x5c000000 + 2300 * 4320 + 400 * 4)
+	mov		w1, #0x0000
+	movk	w1, #0x00ff, lsl #16
+	mov		x2, #32
+	mov		x4, #4320
+Lwillow_blue_row:
+	mov		x5, #64
+	mov		x6, x0
+Lwillow_blue_pix:
+	str		w1, [x6], #4
+	subs	x5, x5, #1
+	b.ne	Lwillow_blue_pix
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lwillow_blue_row
+	dsb		sy
+
+	// Prepare arguments and clean frame pointer for arm_init
+	add		x0, x20, x22
+	sub		x0, x0, x23
+	ret
+#endif
 	/* Ensure TTEs are visible */
 	dsb		ish

diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
new file mode 100644
index 0000000..8f4c808
--- /dev/null
+++ b/osfmk/arm64/sweet_early.c
@@ -0,0 +1,130 @@
+/*
+ * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
+ * per-CPU state: panic() can reach this before a current thread exists.
+ * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
+ * Stop using that mapping before arm_vm_init tears down bootstrap TTBR0.
+ */
+#include <arm64/sweet_early.h>
+
+#if defined(SWEET)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+#define EARLY_FB ((volatile uint32_t *)(uintptr_t)0x5c000000)
+#define EARLY_WIDTH 1080u
+#define EARLY_HEIGHT 2340u
+#define EARLY_STRIDE (4320u / 4)
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_row, early_col;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static void
+sweet_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+void
+sweet_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		sweet_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = (early_row + 1) % EARLY_ROWS;
+		sweet_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = EARLY_FB +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+sweet_early_string(const char *s)
+{
+	while (*s) {
+		sweet_early_putc(*s++);
+	}
+}
+
+void
+sweet_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 8) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | (stage * 28u << 16);
+	for (unsigned int y = 2300 - 32; y < 2300; y++) {
+		for (unsigned int x = stage * 64; x < (stage + 1) * 64; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_string("SWEET EARLY ");
+	sweet_early_putc((char)('0' + stage));
+	sweet_early_string(": ");
+	sweet_early_string(label);
+	sweet_early_putc('\n');
+}
+
+void
+sweet_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	sweet_early_string("\nSWEET EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, sweet_early_putc, 16);
+	va_end(copy);
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_disable(void)
+{
+	sweet_early_mark(8, "leaving bootstrap TTBR0");
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* SWEET */
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
new file mode 100644
index 0000000..fbbc827
--- /dev/null
+++ b/osfmk/arm64/sweet_early.h
@@ -0,0 +1,22 @@
+/* Early screen diagnostics, valid only while the bootstrap TTBR0 is live. */
+#ifndef _ARM64_SWEET_EARLY_H_
+#define _ARM64_SWEET_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+
+#if defined(SWEET)
+void sweet_early_mark(unsigned int stage, const char *label);
+void sweet_early_putc(char c);
+void sweet_early_panic(const char *fmt, va_list *args);
+void sweet_early_disable(void);
+#else
+static inline void sweet_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void sweet_early_disable(void) {}
+#endif
+
+#endif
